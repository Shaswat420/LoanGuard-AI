import { useEffect, useState } from "react";
import { useNavigate, useParams } from "react-router-dom";
import "./Reviewer.css";

const API_URL = "http://localhost:8082/api";

// =========================================================
// TYPES
// =========================================================

type Loan = {
  id: number;
  loanNumber: string;
  borrowerName: string;
  originalLoanAmount: number;
  currentBalance: number;
  interestRate: number;
  loanTermMonths: number;
  loanStatus: string;
  originationDate: string;
  maturityDate: string;
  dataSource: string;
  validationErrorCount: number;
  verificationStatus: string;
  createdAt: string;
  updatedAt: string;
};

type ValidationIssue = {
  rule: string;
  field: string;
  severity: string;
  message: string;
  actualValue: string | null;
  expectedValue: string;
};

type ValidationResult = {
  valid: boolean;
  loanId: number;
  loanNumber: string;
  errorCount: number;
  issues: ValidationIssue[];
};

type RiskFactor = {
  factor: string;
  severity: string;
  impact: string;
  description: string;
};

type RiskAnalysis = {
  loanId: number;
  loanNumber: string;
  riskScore: number;
  riskLevel: string;
  recommendation: string;
  confidence: number;
  validationPassed: boolean;
  validationErrorCount: number;
  factors: RiskFactor[];
};

type AuditLog = {
  id: number;
  loanId: number;
  loanNumber: string;
  eventType: string;
  description: string;
  actor: string;
  createdAt: string;
  recordHash: string;
};

type EditForm = {
  loanNumber: string;
  borrowerName: string;
  originalLoanAmount: string;
  currentBalance: string;
  interestRate: string;
  loanTermMonths: string;
  originationDate: string;
  maturityDate: string;
  loanStatus: string;
  dataSource: string;
};

// =========================================================
// COMPONENT
// =========================================================

function Reviewer() {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();

  const [loan, setLoan] = useState<Loan | null>(null);

  const [validation, setValidation] =
    useState<ValidationResult | null>(null);

  const [riskAnalysis, setRiskAnalysis] =
    useState<RiskAnalysis | null>(null);

  const [auditLogs, setAuditLogs] =
    useState<AuditLog[]>([]);

  const [loading, setLoading] = useState(true);
  const [validating, setValidating] = useState(false);
  const [riskLoading, setRiskLoading] = useState(false);
  const [actionLoading, setActionLoading] = useState(false);
  const [auditLoading, setAuditLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [editing, setEditing] = useState(false);

  const [message, setMessage] = useState("");

  const [editForm, setEditForm] = useState<EditForm>({
    loanNumber: "",
    borrowerName: "",
    originalLoanAmount: "",
    currentBalance: "",
    interestRate: "",
    loanTermMonths: "",
    originationDate: "",
    maturityDate: "",
    loanStatus: "",
    dataSource: "",
  });

  // =========================================================
  // TOKEN
  // =========================================================

  function getToken(): string | null {
    return localStorage.getItem("loanguard_token");
  }

  // =========================================================
  // LOGOUT
  // =========================================================

  function logout() {
    localStorage.removeItem("loanguard_token");
    localStorage.removeItem("loanguard_user");

    navigate("/", {
      replace: true,
    });
  }

  // =========================================================
  // AUTHENTICATED FETCH
  // =========================================================

  async function authenticatedFetch(
    url: string,
    options: RequestInit = {}
  ): Promise<Response> {
    const token = getToken();

    if (!token) {
      logout();

      throw new Error(
        "Your session has expired. Please sign in again."
      );
    }

    const headers = new Headers(
      options.headers || {}
    );

    headers.set(
      "Authorization",
      `Bearer ${token}`
    );

    if (
      options.body &&
      !(options.body instanceof FormData) &&
      !headers.has("Content-Type")
    ) {
      headers.set(
        "Content-Type",
        "application/json"
      );
    }

    headers.set(
      "Accept",
      "application/json"
    );

    const response = await fetch(url, {
      ...options,
      headers,
    });

    // =====================================================
    // AUTH FAILURE
    // =====================================================

    if (
      response.status === 401 ||
      response.status === 403
    ) {
      logout();

      throw new Error(
        "Your session has expired or you do not have permission to access this resource."
      );
    }

    return response;
  }

  // =========================================================
  // LOAD PAGE
  // =========================================================

  useEffect(() => {
    if (!id) {
      setMessage("No loan ID was provided.");
      setLoading(false);
      return;
    }

    loadLoan();
    loadAuditLogs();
  }, [id]);

  // =========================================================
  // POPULATE EDIT FORM
  // =========================================================

  function populateEditForm(data: Loan) {
    setEditForm({
      loanNumber: data.loanNumber ?? "",

      borrowerName:
        data.borrowerName ?? "",

      originalLoanAmount:
        data.originalLoanAmount?.toString() ?? "",

      currentBalance:
        data.currentBalance?.toString() ?? "",

      interestRate:
        data.interestRate?.toString() ?? "",

      loanTermMonths:
        data.loanTermMonths?.toString() ?? "",

      originationDate:
        data.originationDate ?? "",

      maturityDate:
        data.maturityDate ?? "",

      loanStatus:
        data.loanStatus ?? "",

      dataSource:
        data.dataSource ?? "",
    });
  }

  // =========================================================
  // LOAD LOAN
  // =========================================================

  async function loadLoan() {
    if (!id) {
      return;
    }

    try {
      setLoading(true);
      setMessage("");

      /*
       * IMPORTANT:
       *
       * LoanController already exposes:
       *
       * GET /api/loans/{id}
       *
       * So we use that endpoint instead of:
       *
       * /api/reviewer/loans/{id}
       */

      const response =
        await authenticatedFetch(
          `${API_URL}/loans/${id}`
        );

      if (!response.ok) {
        let backendMessage = "";

        try {
          const data =
            await response.json();

          backendMessage =
            data?.message ||
            data?.error ||
            "";
        } catch {
          // Ignore parsing error.
        }

        throw new Error(
          backendMessage ||
            `Unable to load loan. Server returned ${response.status}.`
        );
      }

      const data: Loan =
        await response.json();

      setLoan(data);

      populateEditForm(data);

    } catch (error) {
      console.error(
        "Load loan error:",
        error
      );

      setLoan(null);

      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to load loan from backend."
      );

    } finally {
      setLoading(false);
    }
  }

  // =========================================================
  // REMOVE DUPLICATE AUDIT LOGS
  // =========================================================

  function removeDuplicateAuditLogs(
    logs: AuditLog[]
  ): AuditLog[] {
    const seen = new Set<string>();

    const sortedLogs = [...logs].sort(
      (a, b) =>
        new Date(b.createdAt).getTime() -
        new Date(a.createdAt).getTime()
    );

    return sortedLogs.filter((log) => {
      const duplicateKey = [
        log.eventType,
        log.description,
        log.actor,
        log.recordHash,
      ].join("|");

      if (seen.has(duplicateKey)) {
        return false;
      }

      seen.add(duplicateKey);

      return true;
    });
  }

  // =========================================================
  // LOAD AUDIT LOGS
  // =========================================================

  async function loadAuditLogs() {
    if (!id) {
      return;
    }

    try {
      setAuditLoading(true);

      const response =
        await authenticatedFetch(
          `${API_URL}/audit/loans/${id}`
        );

      if (!response.ok) {
        throw new Error(
          `Unable to load audit history. Status ${response.status}`
        );
      }

      const data: AuditLog[] =
        await response.json();

      const uniqueLogs =
        removeDuplicateAuditLogs(data);

      setAuditLogs(uniqueLogs);

    } catch (error) {
      console.error(
        "Audit history error:",
        error
      );

      setAuditLogs([]);

    } finally {
      setAuditLoading(false);
    }
  }

  // =========================================================
  // VALIDATE LOAN
  // =========================================================

  async function validateLoan() {
    if (!id) {
      return;
    }

    try {
      setValidating(true);
      setMessage("");

      const response =
        await authenticatedFetch(
          `${API_URL}/loans/${id}/validate`,
          {
            method: "POST",
          }
        );

      if (!response.ok) {
        let backendMessage = "";

        try {
          const data =
            await response.json();

          backendMessage =
            data?.message ||
            data?.error ||
            "";
        } catch {
          // Ignore.
        }

        throw new Error(
          backendMessage ||
            "Validation failed."
        );
      }

      const result: ValidationResult =
        await response.json();

      setValidation(result);

      await loadLoan();
      await loadAuditLogs();

      if (result.valid) {
        setMessage(
          "Validation completed successfully. No issues detected."
        );
      } else {
        setMessage(
          `${result.errorCount} validation issue(s) detected.`
        );
      }

    } catch (error) {
      console.error(
        "Validation error:",
        error
      );

      setMessage(
        error instanceof Error
          ? error.message
          : "Loan validation failed."
      );

    } finally {
      setValidating(false);
    }
  }

  // =========================================================
  // RISK ANALYSIS
  // =========================================================

  async function analyzeRisk() {
    if (!id) {
      return;
    }

    try {
      setRiskLoading(true);
      setMessage("");

      const response =
        await authenticatedFetch(
          `${API_URL}/risk/loans/${id}`
        );

      if (!response.ok) {
        let backendMessage = "";

        try {
          const data =
            await response.json();

          backendMessage =
            data?.message ||
            data?.error ||
            "";
        } catch {
          // Ignore.
        }

        throw new Error(
          backendMessage ||
            "Risk analysis failed."
        );
      }

      const result: RiskAnalysis =
        await response.json();

      setRiskAnalysis(result);

      await loadAuditLogs();

      setMessage(
        "Risk analysis completed."
      );

    } catch (error) {
      console.error(
        "Risk analysis error:",
        error
      );

      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to run risk analysis."
      );

    } finally {
      setRiskLoading(false);
    }
  }

  // =========================================================
  // START EDITING
  // =========================================================

  function startEditing() {
    if (!loan) {
      return;
    }

    populateEditForm(loan);

    setEditing(true);
    setMessage("");
  }

  // =========================================================
  // CANCEL EDITING
  // =========================================================

  function cancelEditing() {
    if (loan) {
      populateEditForm(loan);
    }

    setEditing(false);
    setMessage("");
  }

  // =========================================================
  // UPDATE EDIT FIELD
  // =========================================================

  function updateEditField(
    field: keyof EditForm,
    value: string
  ) {
    setEditForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  // =========================================================
  // SAVE LOAN
  // =========================================================

  async function saveLoan() {
    if (!id) {
      return;
    }

    try {
      setSaving(true);
      setMessage("");

      const originalLoanAmount =
        Number(
          editForm.originalLoanAmount
        );

      const currentBalance =
        Number(
          editForm.currentBalance
        );

      const interestRate =
        Number(
          editForm.interestRate
        );

      const loanTermMonths =
        Number(
          editForm.loanTermMonths
        );

      // =====================================================
      // VALIDATION
      // =====================================================

      if (
        !editForm.loanNumber.trim()
      ) {
        setMessage(
          "Loan number is required."
        );
        return;
      }

      if (
        !editForm.borrowerName.trim()
      ) {
        setMessage(
          "Borrower name is required."
        );
        return;
      }

      if (
        Number.isNaN(
          originalLoanAmount
        ) ||
        originalLoanAmount < 0
      ) {
        setMessage(
          "Enter a valid original loan amount."
        );
        return;
      }

      if (
        Number.isNaN(
          currentBalance
        ) ||
        currentBalance < 0
      ) {
        setMessage(
          "Enter a valid current balance."
        );
        return;
      }

      if (
        Number.isNaN(
          interestRate
        ) ||
        interestRate < 0
      ) {
        setMessage(
          "Enter a valid interest rate."
        );
        return;
      }

      if (
        Number.isNaN(
          loanTermMonths
        ) ||
        loanTermMonths <= 0
      ) {
        setMessage(
          "Enter a valid loan term."
        );
        return;
      }

      // =====================================================
      // PAYLOAD
      // =====================================================

      const payload = {
        loanNumber:
          editForm.loanNumber.trim(),

        borrowerName:
          editForm.borrowerName.trim(),

        originalLoanAmount,

        currentBalance,

        interestRate,

        loanTermMonths,

        originationDate:
          editForm.originationDate,

        maturityDate:
          editForm.maturityDate,

        loanStatus:
          editForm.loanStatus,

        dataSource:
          editForm.dataSource.trim(),
      };

      // =====================================================
      // IMPORTANT
      //
      // Use the LoanController endpoint:
      //
      // PUT /api/loans/{id}
      // =====================================================

      const response =
        await authenticatedFetch(
          `${API_URL}/loans/${id}`,
          {
            method: "PUT",
            body: JSON.stringify(
              payload
            ),
          }
        );

      if (!response.ok) {
        let backendMessage = "";

        try {
          const data =
            await response.json();

          backendMessage =
            data?.message ||
            data?.error ||
            "";
        } catch {
          // Ignore.
        }

        throw new Error(
          backendMessage ||
            `Unable to save loan. Server returned ${response.status}.`
        );
      }

      const responseData =
        await response.json();

      /*
       * Your LoanController PUT returns:
       *
       * {
       *   loan: savedLoan,
       *   valid: false,
       *   validationErrorCount: 0,
       *   issues: [],
       *   requiresRevalidation: true
       * }
       */

      const savedLoan: Loan =
        responseData?.loan ||
        responseData;

      setLoan(savedLoan);

      populateEditForm(
        savedLoan
      );

      setEditing(false);

      /*
       * Existing AI results are no longer valid
       * after the loan is modified.
       */

      setValidation(null);
      setRiskAnalysis(null);

      await loadLoan();
      await loadAuditLogs();

      setMessage(
        "Loan changes saved. Revalidation is required."
      );

    } catch (error) {
      console.error(
        "Save loan error:",
        error
      );

      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to save loan changes."
      );

    } finally {
      setSaving(false);
    }
  }

  // =========================================================
  // REVIEWER ACTION
  // =========================================================

  async function reviewerAction(
    action:
      | "approve"
      | "reject"
      | "review"
  ) {
    if (!id) {
      return;
    }

    try {
      setActionLoading(true);
      setMessage("");

      if (editing) {
        setMessage(
          "Finish editing the loan before taking a review decision."
        );
        return;
      }

      // =====================================================
      // APPROVAL VALIDATION
      // =====================================================

      if (action === "approve") {
        if (!validation?.valid) {
          setMessage(
            "Run validation and resolve all issues before approval."
          );
          return;
        }
      }

      // =====================================================
      // REVIEWER ENDPOINT
      //
      // SecurityConfig protects /api/reviewer/**
      // so authenticatedFetch MUST be used.
      // =====================================================

      const response =
        await authenticatedFetch(
          `${API_URL}/reviewer/loans/${id}/${action}`,
          {
            method: "POST",
          }
        );

      if (!response.ok) {
        let backendMessage = "";

        try {
          const data =
            await response.json();

          backendMessage =
            data?.message ||
            data?.error ||
            "";
        } catch {
          // Ignore.
        }

        throw new Error(
          backendMessage ||
            `Reviewer action failed. Server returned ${response.status}.`
        );
      }

      const updatedLoan: Loan =
        await response.json();

      setLoan(updatedLoan);

      populateEditForm(
        updatedLoan
      );

      if (action === "approve") {
        setMessage(
          "Loan approved successfully."
        );
      } else if (action === "reject") {
        setMessage(
          "Loan rejected successfully."
        );
      } else {
        setMessage(
          "Loan marked for human review."
        );
      }

      await loadLoan();
      await loadAuditLogs();

    } catch (error) {
      console.error(
        "Reviewer action error:",
        error
      );

      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to update loan."
      );

    } finally {
      setActionLoading(false);
    }
  }

  // =========================================================
  // FORMAT MONEY
  // =========================================================

  function formatMoney(
    value: number
  ) {
    return new Intl.NumberFormat(
      "en-IN",
      {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0,
      }
    ).format(value ?? 0);
  }

  // =========================================================
  // FORMAT DATE
  // =========================================================

  function formatDate(
    value: string
  ) {
    if (!value) {
      return "—";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return value;
    }

    return date.toLocaleDateString(
      "en-IN",
      {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }
    );
  }

  // =========================================================
  // FORMAT AUDIT DATE
  // =========================================================

  function formatAuditDate(
    value: string
  ) {
    if (!value) {
      return "—";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return value;
    }

    return date.toLocaleString(
      "en-IN",
      {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }

  // =========================================================
  // AUDIT EVENT
  // =========================================================

  function formatAuditEvent(
    eventType: string
  ) {
    switch (eventType) {
      case "RECORD_CREATED":
        return "Record Created";

      case "VALIDATION_RUN":
        return "Validation Completed";

      case "RECORD_UPDATED":
        return "Record Updated";

      case "RISK_ANALYSIS_RUN":
        return "Risk Analysis Completed";

      case "RECORD_APPROVED":
        return "Record Approved";

      case "RECORD_REJECTED":
        return "Record Rejected";

      case "RECORD_NEEDS_REVIEW":
        return "Marked for Human Review";

      default:
        return eventType
          .replaceAll("_", " ")
          .replace(
            /\b\w/g,
            (character) =>
              character.toUpperCase()
          );
    }
  }

  // =========================================================
  // STATUS CLASS
  // =========================================================

  function getStatusClass(
    status: string
  ) {
    switch (status) {
      case "VERIFIED":
        return "review-status verified";

      case "REJECTED":
        return "review-status rejected";

      case "NEEDS_REVIEW":
        return "review-status needs-review";

      default:
        return "review-status pending";
    }
  }

  // =========================================================
  // RISK LEVEL CLASS
  // =========================================================

  function getRiskLevelClass(
    level: string
  ) {
    return `risk-level ${level
      ?.toLowerCase()
      .replaceAll(" ", "-")}`;
  }

  // =========================================================
  // SEVERITY CLASS
  // =========================================================

  function getSeverityClass(
    severity: string
  ) {
    return `risk-severity ${severity?.toLowerCase()}`;
  }

  // =========================================================
  // IMPACT CLASS
  // =========================================================

  function getImpactClass(
    impact: string
  ) {
    return `risk-impact ${impact?.toLowerCase()}`;
  }

  // =========================================================
  // RECOMMENDATION CLASS
  // =========================================================

  function getRecommendationClass(
    recommendation: string
  ) {
    return `recommendation-badge ${recommendation
      ?.toLowerCase()
      .replaceAll("_", "-")
      .replaceAll(" ", "-")}`;
  }

  // =========================================================
  // SCORE CLASS
  // =========================================================

  function getScoreClass(
    score: number
  ) {
    if (score >= 60) {
      return "score-high";
    }

    if (score >= 30) {
      return "score-medium";
    }

    return "score-low";
  }

  // =========================================================
  // LOADING
  // =========================================================

  if (loading) {
    return (
      <div className="reviewer-page">

        <div className="reviewer-loading">

          <div className="loading-spinner"></div>

          <p>
            Loading loan record...
          </p>

        </div>

      </div>
    );
  }

  // =========================================================
  // LOAN NOT FOUND
  // =========================================================

  if (!loan) {
    return (
      <div className="reviewer-page">

        <div className="reviewer-error">

          <h2>
            Loan not found
          </h2>

          <p>
            {message ||
              "The requested loan does not exist."}
          </p>

          <button
            className="back-button"
            onClick={() =>
              navigate("/loans")
            }
          >
            ← Back to Loan Records
          </button>

        </div>

      </div>
    );
  }

  // =========================================================
  // RENDER
  // =========================================================

  return (
    <div className="reviewer-page">

      {/* =====================================================
          HEADER
      ===================================================== */}

      <header className="reviewer-header">

        <div>

          <button
            className="back-link"
            onClick={() =>
              navigate("/loans")
            }
          >
            ← Loan Records
          </button>

          <div className="reviewer-eyebrow">
            LOAN DATA VERIFICATION COPILOT
          </div>

          <h1>
            AI Reviewer
          </h1>

          <p>
            Review, validate and verify
            loan-level data before it
            becomes part of the trusted
            dataset.
          </p>

        </div>

        <div
          className={getStatusClass(
            loan.verificationStatus
          )}
        >
          <span className="status-dot"></span>

          {loan.verificationStatus.replaceAll(
            "_",
            " "
          )}

        </div>

      </header>

      {/* =====================================================
          MESSAGE
      ===================================================== */}

      {message && (
        <div className="reviewer-message">
          {message}
        </div>
      )}

      {/* =====================================================
          IDENTITY
      ===================================================== */}

      <section className="loan-identity">

        <div>
          <span>
            LOAN RECORD
          </span>

          <strong>
            {loan.loanNumber}
          </strong>
        </div>

        <div>
          <span>
            BORROWER
          </span>

          <strong>
            {loan.borrowerName}
          </strong>
        </div>

        <div>
          <span>
            SOURCE
          </span>

          <strong>
            {loan.dataSource}
          </strong>
        </div>

        <div>
          <span>
            RECORD ID
          </span>

          <strong>
            #{loan.id}
          </strong>
        </div>

      </section>

      {/* =====================================================
          EDIT PANEL
      ===================================================== */}

      {editing && (
        <section className="panel edit-panel">

          <div className="panel-heading">

            <div>

              <div className="panel-label">
                RECORD EDITOR
              </div>

              <h2>
                Edit Loan
              </h2>

            </div>

            <div className="editing-indicator">
              Editing
            </div>

          </div>

          <div className="edit-status">

            <span className="edit-status-dot"></span>

            Changes will reset the current
            verification state and require
            revalidation.

          </div>

          <div className="edit-form">

            <EditField
              label="Loan Number"
              value={editForm.loanNumber}
              onChange={(value) =>
                updateEditField(
                  "loanNumber",
                  value
                )
              }
            />

            <EditField
              label="Borrower Name"
              value={editForm.borrowerName}
              onChange={(value) =>
                updateEditField(
                  "borrowerName",
                  value
                )
              }
            />

            <EditField
              label="Original Loan Amount"
              type="number"
              value={
                editForm.originalLoanAmount
              }
              onChange={(value) =>
                updateEditField(
                  "originalLoanAmount",
                  value
                )
              }
            />

            <EditField
              label="Current Balance"
              type="number"
              value={
                editForm.currentBalance
              }
              onChange={(value) =>
                updateEditField(
                  "currentBalance",
                  value
                )
              }
            />

            <EditField
              label="Interest Rate"
              type="number"
              step="0.01"
              value={
                editForm.interestRate
              }
              onChange={(value) =>
                updateEditField(
                  "interestRate",
                  value
                )
              }
            />

            <EditField
              label="Loan Term"
              type="number"
              value={
                editForm.loanTermMonths
              }
              onChange={(value) =>
                updateEditField(
                  "loanTermMonths",
                  value
                )
              }
            />

            <EditField
              label="Origination Date"
              type="date"
              value={
                editForm.originationDate
              }
              onChange={(value) =>
                updateEditField(
                  "originationDate",
                  value
                )
              }
            />

            <EditField
              label="Maturity Date"
              type="date"
              value={
                editForm.maturityDate
              }
              onChange={(value) =>
                updateEditField(
                  "maturityDate",
                  value
                )
              }
            />

            <div className="edit-field">

              <label>
                Loan Status
              </label>

              <select
                value={
                  editForm.loanStatus
                }
                onChange={(event) =>
                  updateEditField(
                    "loanStatus",
                    event.target.value
                  )
                }
              >
                <option value="ACTIVE">
                  ACTIVE
                </option>

                <option value="CLOSED">
                  CLOSED
                </option>

                <option value="DEFAULT">
                  DEFAULT
                </option>

                <option value="PAID_OFF">
                  PAID_OFF
                </option>

              </select>

            </div>

            <EditField
              label="Data Source"
              value={editForm.dataSource}
              onChange={(value) =>
                updateEditField(
                  "dataSource",
                  value
                )
              }
            />

          </div>

          <div className="edit-actions">

            <button
              className="cancel-button"
              onClick={cancelEditing}
              disabled={saving}
            >
              Cancel
            </button>

            <button
              className="save-button"
              onClick={saveLoan}
              disabled={saving}
            >
              {saving
                ? "Saving Changes..."
                : "Save Changes"}
            </button>

          </div>

        </section>
      )}

      {/* =====================================================
          MAIN GRID
      ===================================================== */}

      <div className="reviewer-grid">

        {/* ===================================================
            LEFT SIDE
        =================================================== */}

        <main>

          {/* =================================================
              VALIDATION
          ================================================= */}

          <section className="panel ai-panel">

            <div className="panel-heading">

              <div>

                <div className="panel-label">
                  AI ASSISTED REVIEW
                </div>

                <h2>
                  Verification Analysis
                </h2>

              </div>

              <div className="ai-badge">
                AI
              </div>

            </div>

            {!validation ? (

              <div className="ai-empty">

                <div className="ai-icon">
                  ✦
                </div>

                <h3>
                  Run verification analysis
                </h3>

                <p>
                  The verification engine will
                  inspect this loan for data-quality
                  issues and generate an explanation
                  for the reviewer.
                </p>

                <button
                  className="primary-button"
                  onClick={validateLoan}
                  disabled={validating}
                >
                  {validating
                    ? "Analyzing Loan..."
                    : "Run AI Review"}
                </button>

              </div>

            ) : (

              <div className="analysis-result">

                <div
                  className={
                    validation.valid
                      ? "analysis-summary valid"
                      : "analysis-summary invalid"
                  }
                >

                  <div className="analysis-icon">
                    {validation.valid
                      ? "✓"
                      : "!"}
                  </div>

                  <div>

                    <strong>
                      {validation.valid
                        ? "No validation issues detected"
                        : `${validation.errorCount} issue(s) detected`}
                    </strong>

                    <p>
                      {validation.valid
                        ? "The current loan record passed the configured data-quality checks."
                        : "The loan record requires reviewer attention before verification."}
                    </p>

                  </div>

                </div>

                <div className="analysis-section">

                  <div className="section-title">
                    DETECTED ISSUES
                  </div>

                  {validation.issues.length ===
                  0 ? (

                    <div className="clean-result">

                      <span>
                        ✓
                      </span>

                      All configured validation
                      checks passed.

                    </div>

                  ) : (

                    <div className="issues-list">

                      {validation.issues.map(
                        (issue, index) => (

                          <div
                            className="issue-row"
                            key={`${issue.rule}-${index}`}
                          >

                            <span className="issue-number">
                              {index + 1}
                            </span>

                            <div className="issue-content">

                              <strong>
                                {issue.message}
                              </strong>

                              <small>
                                Rule: {issue.rule}
                              </small>

                              <small>
                                Field: {issue.field}
                              </small>

                              <small>
                                Severity:{" "}
                                {issue.severity}
                              </small>

                              {issue.actualValue !==
                                null && (
                                <small>
                                  Actual:{" "}
                                  {issue.actualValue}
                                </small>
                              )}

                              <small>
                                Expected:{" "}
                                {issue.expectedValue}
                              </small>

                            </div>

                          </div>

                        )
                      )}

                    </div>

                  )}

                </div>

                <div className="analysis-section">

                  <div className="section-title">
                    AI EXPLANATION
                  </div>

                  <div className="ai-explanation">

                    {validation.valid ? (
                      <>
                        <strong>
                          Recommendation: Approve
                        </strong>

                        <p>
                          The loan contains no detected
                          validation exceptions. Key
                          financial, identity and lifecycle
                          fields are currently consistent
                          with the configured validation
                          rules.
                        </p>
                      </>
                    ) : (
                      <>
                        <strong>
                          Recommendation: Human Review
                        </strong>

                        <p>
                          One or more data-quality
                          exceptions were detected.
                          Inspect the affected fields,
                          correct the data where necessary,
                          and revalidate before approval.
                        </p>
                      </>
                    )}

                  </div>

                </div>

              </div>

            )}

          </section>

          {/* =================================================
              REVALIDATION
          ================================================= */}

          {loan.verificationStatus ===
            "PENDING" &&
            !editing &&
            validation === null && (

              <div className="revalidation-banner">

                <div>

                  <strong>
                    Revalidation required
                  </strong>

                  <p>
                    This record was recently changed.
                    Run AI Review before approving it.
                  </p>

                </div>

              </div>

            )}

          {validation?.valid && (
            <div className="validation-clean-banner">
              ✓ Record passed all configured
              validation checks.
            </div>
          )}

          {/* =================================================
              RISK
          ================================================= */}

          <section className="panel risk-panel">

            <div className="panel-heading">

              <div>

                <div className="panel-label">
                  AI RISK ENGINE
                </div>

                <h2>
                  Risk Analysis
                </h2>

              </div>

              <div className="ai-badge">
                AI
              </div>

            </div>

            {!riskAnalysis ? (

              <div className="ai-empty">

                <div className="ai-icon risk-icon">
                  ◈
                </div>

                <h3>
                  Run risk analysis
                </h3>

                <p>
                  The risk engine evaluates data
                  quality, loan balance, interest
                  rate, lifecycle and loan status
                  to generate a risk assessment.
                </p>

                <button
                  className="primary-button"
                  onClick={analyzeRisk}
                  disabled={riskLoading}
                >
                  {riskLoading
                    ? "Analyzing Risk..."
                    : "Run Risk Analysis"}
                </button>

              </div>

            ) : (

              <div className="risk-result">

                <div className="risk-overview">

                  <div
                    className={`risk-score-box ${getScoreClass(
                      riskAnalysis.riskScore
                    )}`}
                  >

                    <span className="risk-score">
                      {riskAnalysis.riskScore}
                    </span>

                    <span className="risk-score-label">
                      RISK SCORE
                    </span>

                  </div>

                  <div className="risk-summary">

                    <span className="risk-label">
                      RISK LEVEL
                    </span>

                    <strong
                      className={getRiskLevelClass(
                        riskAnalysis.riskLevel
                      )}
                    >
                      {riskAnalysis.riskLevel}
                    </strong>

                    <span className="risk-confidence">
                      Confidence:{" "}
                      {riskAnalysis.confidence}%
                    </span>

                  </div>

                </div>

                <div className="risk-recommendation">

                  <div>

                    <span>
                      AI RECOMMENDATION
                    </span>

                    <strong
                      className={getRecommendationClass(
                        riskAnalysis.recommendation
                      )}
                    >
                      {riskAnalysis.recommendation.replaceAll(
                        "_",
                        " "
                      )}
                    </strong>

                  </div>

                  <div className="recommendation-confidence">
                    {riskAnalysis.confidence}%
                    confidence
                  </div>

                </div>

                <div className="analysis-section">

                  <div className="section-title">
                    RISK FACTORS
                  </div>

                  <div className="risk-factors">

                    {riskAnalysis.factors?.map(
                      (factor, index) => (

                        <div
                          className="risk-factor"
                          key={`${factor.factor}-${index}`}
                        >

                          <div className="risk-factor-top">

                            <strong>
                              {factor.factor}
                            </strong>

                            <div className="risk-factor-tags">

                              <span
                                className={getSeverityClass(
                                  factor.severity
                                )}
                              >
                                {factor.severity}
                              </span>

                              <span
                                className={getImpactClass(
                                  factor.impact
                                )}
                              >
                                {factor.impact}
                              </span>

                            </div>

                          </div>

                          <p>
                            {factor.description}
                          </p>

                        </div>

                      )
                    )}

                  </div>

                </div>

                <div className="risk-validation">

                  <span className="validation-check">
                    {riskAnalysis.validationPassed
                      ? "✓"
                      : "!"}
                  </span>

                  <div>

                    <strong>
                      {riskAnalysis.validationPassed
                        ? "Validation passed"
                        : "Validation exceptions detected"}
                    </strong>

                    <p>
                      {
                        riskAnalysis.validationErrorCount
                      }{" "}
                      validation error(s) recorded.
                    </p>

                  </div>

                </div>

              </div>

            )}

          </section>

          {/* =================================================
              LOAN DATA
          ================================================= */}

          <section className="panel">

            <div className="panel-heading">

              <div>

                <div className="panel-label">
                  NORMALIZED RECORD
                </div>

                <h2>
                  Loan Data
                </h2>

              </div>

              {!editing && (
                <button
                  className="edit-button"
                  onClick={startEditing}
                  disabled={actionLoading}
                >
                  Edit Loan
                </button>
              )}

            </div>

            <div className="data-grid">

              <DataItem
                label="Borrower"
                value={
                  loan.borrowerName
                }
              />

              <DataItem
                label="Loan Number"
                value={
                  loan.loanNumber
                }
              />

              <DataItem
                label="Original Amount"
                value={formatMoney(
                  loan.originalLoanAmount
                )}
              />

              <DataItem
                label="Current Balance"
                value={formatMoney(
                  loan.currentBalance
                )}
              />

              <DataItem
                label="Interest Rate"
                value={`${loan.interestRate}%`}
              />

              <DataItem
                label="Loan Term"
                value={`${loan.loanTermMonths} months`}
              />

              <DataItem
                label="Loan Status"
                value={
                  loan.loanStatus
                }
              />

              <DataItem
                label="Data Source"
                value={
                  loan.dataSource
                }
              />

              <DataItem
                label="Origination Date"
                value={formatDate(
                  loan.originationDate
                )}
              />

              <DataItem
                label="Maturity Date"
                value={formatDate(
                  loan.maturityDate
                )}
              />

            </div>

          </section>

        </main>

        {/* ===================================================
            RIGHT SIDE
        =================================================== */}

        <aside>

          {/* =================================================
              DECISION
          ================================================= */}

          <section className="panel decision-panel">

            <div className="panel-label">
              REVIEW DECISION
            </div>

            <h2>
              What should happen?
            </h2>

            <p>
              Choose the appropriate disposition
              for this loan record.
            </p>

            {riskAnalysis && (

              <div className="ai-decision-hint">

                <span>
                  AI RECOMMENDS
                </span>

                <strong
                  className={getRecommendationClass(
                    riskAnalysis.recommendation
                  )}
                >
                  {riskAnalysis.recommendation.replaceAll(
                    "_",
                    " "
                  )}
                </strong>

              </div>

            )}

            <button
              className="decision approve"
              disabled={
                actionLoading ||
                editing ||
                !validation?.valid
              }
              onClick={() =>
                reviewerAction(
                  "approve"
                )
              }
            >

              <span>
                ✓
              </span>

              <div>

                <strong>
                  Approve
                </strong>

                <small>
                  Mark record as verified
                </small>

              </div>

            </button>

            <button
              className="decision review"
              disabled={
                actionLoading ||
                editing
              }
              onClick={() =>
                reviewerAction(
                  "review"
                )
              }
            >

              <span>
                !
              </span>

              <div>

                <strong>
                  Needs Review
                </strong>

                <small>
                  Keep exception open
                </small>

              </div>

            </button>

            <button
              className="decision reject"
              disabled={
                actionLoading ||
                editing
              }
              onClick={() =>
                reviewerAction(
                  "reject"
                )
              }
            >

              <span>
                ×
              </span>

              <div>

                <strong>
                  Reject
                </strong>

                <small>
                  Mark record as rejected
                </small>

              </div>

            </button>

            {!validation?.valid && (

              <div className="approval-warning">
                Approval is disabled until the
                loan passes validation.
              </div>

            )}

          </section>

          {/* =================================================
              DATA QUALITY
          ================================================= */}

          <section className="panel quality-panel">

            <div className="panel-label">
              DATA QUALITY
            </div>

            <div className="quality-score">

              <div className="score-circle">

                {validation
                  ? validation.valid
                    ? "100"
                    : Math.max(
                        0,
                        100 -
                          validation.errorCount *
                            15
                      )
                  : "—"}

              </div>

              <div>

                <strong>
                  Verification Score
                </strong>

                <p>
                  Based on configured
                  validation rules.
                </p>

              </div>

            </div>

            <div className="quality-row">

              <span>
                Validation errors
              </span>

              <strong>
                {validation
                  ? validation.errorCount
                  : loan.validationErrorCount}
              </strong>

            </div>

            <div className="quality-row">

              <span>
                Verification state
              </span>

              <strong>
                {loan.verificationStatus.replaceAll(
                  "_",
                  " "
                )}
              </strong>

            </div>

          </section>

          {/* =================================================
              RISK SUMMARY
          ================================================= */}

          <section className="panel risk-summary-panel">

            <div className="panel-label">
              RISK SUMMARY
            </div>

            {riskAnalysis ? (

              <>

                <div className="mini-risk-score">

                  <strong>
                    {riskAnalysis.riskScore}
                  </strong>

                  <span>
                    / 100
                  </span>

                </div>

                <div className="summary-row">

                  <span>
                    Risk level
                  </span>

                  <strong
                    className={getRiskLevelClass(
                      riskAnalysis.riskLevel
                    )}
                  >
                    {riskAnalysis.riskLevel}
                  </strong>

                </div>

                <div className="summary-row">

                  <span>
                    Recommendation
                  </span>

                  <strong>
                    {riskAnalysis.recommendation.replaceAll(
                      "_",
                      " "
                    )}
                  </strong>

                </div>

                <div className="summary-row">

                  <span>
                    Confidence
                  </span>

                  <strong>
                    {riskAnalysis.confidence}%
                  </strong>

                </div>

              </>

            ) : (

              <div className="risk-summary-empty">

                <span>
                  —
                </span>

                <p>
                  Run risk analysis to view
                  the AI assessment.
                </p>

              </div>

            )}

          </section>

          {/* =================================================
              AUDIT
          ================================================= */}

          <section className="panel audit-panel">

            <div className="panel-label">
              AUDIT / TRACEABILITY
            </div>

            <h3>
              Record Timeline
            </h3>

            {auditLoading ? (

              <div className="audit-loading">
                Loading audit history...
              </div>

            ) : auditLogs.length === 0 ? (

              <div className="audit-empty">

                <span>
                  —
                </span>

                <p>
                  No audit events recorded yet.
                </p>

              </div>

            ) : (

              <div className="audit-timeline">

                {auditLogs.map(
                  (audit) => (

                    <div
                      className="audit-event"
                      key={audit.id}
                    >

                      <div className="audit-event-marker">
                        <span></span>
                      </div>

                      <div className="audit-event-content">

                        <div className="audit-event-header">

                          <strong>
                            {formatAuditEvent(
                              audit.eventType
                            )}
                          </strong>

                          <span
                            className={`audit-actor ${
                              audit.actor?.toLowerCase() ||
                              "system"
                            }`}
                          >
                            {audit.actor ||
                              "SYSTEM"}
                          </span>

                        </div>

                        <p>
                          {audit.description}
                        </p>

                        <small>
                          {formatAuditDate(
                            audit.createdAt
                          )}
                        </small>

                        {audit.recordHash && (

                          <div className="audit-hash">

                            Hash:{" "}
                            {audit.recordHash.slice(
                              0,
                              16
                            )}
                            ...

                          </div>

                        )}

                      </div>

                    </div>

                  )
                )}

              </div>

            )}

          </section>

        </aside>

      </div>

    </div>
  );
}

// =========================================================
// EDIT FIELD
// =========================================================

function EditField({
  label,
  value,
  onChange,
  type = "text",
  step,
}: {
  label: string;
  value: string;
  onChange: (
    value: string
  ) => void;
  type?: string;
  step?: string;
}) {
  return (
    <div className="edit-field">

      <label>
        {label}
      </label>

      <input
        type={type}
        step={step}
        value={value}
        onChange={(event) =>
          onChange(
            event.target.value
          )
        }
      />

    </div>
  );
}

// =========================================================
// DATA ITEM
// =========================================================

function DataItem({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="data-item">

      <span>
        {label}
      </span>

      <strong>
        {value}
      </strong>

    </div>
  );
}

export default Reviewer;