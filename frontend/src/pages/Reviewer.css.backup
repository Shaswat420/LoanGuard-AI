/* =========================================================
   REVIEWER PAGE
   ========================================================= */

.reviewer-page {
  min-height: 100vh;
  padding: 40px 48px 70px;
  background: #f8fafc;
  color: #111827;
}


/* =========================================================
   HEADER
   ========================================================= */

.reviewer-header {
  max-width: 1400px;
  margin: 0 auto 28px;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;
}

.back-link {
  border: none;
  background: transparent;
  padding: 0;
  margin-bottom: 22px;

  font-size: 13px;
  font-weight: 600;
  color: #64748b;

  cursor: pointer;
}

.back-link:hover {
  color: #111827;
}

.reviewer-eyebrow {
  margin-bottom: 8px;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: #64748b;
}

.reviewer-header h1 {
  margin: 0;

  font-size: 38px;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.reviewer-header p {
  max-width: 650px;
  margin: 12px 0 0;

  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}


/* =========================================================
   STATUS
   ========================================================= */

.review-status {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  padding: 9px 14px;

  border-radius: 999px;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
  white-space: nowrap;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  display: inline-block;
}

.review-status.verified {
  background: #ecfdf5;
  color: #047857;
}

.review-status.verified .status-dot {
  background: #10b981;
}

.review-status.rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.review-status.rejected .status-dot {
  background: #ef4444;
}

.review-status.needs-review {
  background: #fffbeb;
  color: #b45309;
}

.review-status.needs-review .status-dot {
  background: #f59e0b;
}

.review-status.pending {
  background: #f1f5f9;
  color: #475569;
}

.review-status.pending .status-dot {
  background: #94a3b8;
}


/* =========================================================
   MESSAGE
   ========================================================= */

.reviewer-message {
  max-width: 1400px;
  margin: 0 auto 20px;

  padding: 13px 16px;

  border: 1px solid #bfdbfe;
  border-radius: 10px;

  background: #eff6ff;
  color: #1d4ed8;

  font-size: 13px;
  font-weight: 600;
}


/* =========================================================
   LOAN IDENTITY
   ========================================================= */

.loan-identity {
  max-width: 1400px;
  margin: 0 auto 24px;

  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  background: #ffffff;
  overflow: hidden;
}

.loan-identity > div {
  min-height: 82px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 17px 20px;

  border-right: 1px solid #e2e8f0;
}

.loan-identity > div:last-child {
  border-right: none;
}

.loan-identity span {
  margin-bottom: 6px;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;

  color: #94a3b8;
}

.loan-identity strong {
  font-size: 14px;
  color: #0f172a;
}


/* =========================================================
   MAIN GRID
   ========================================================= */

.reviewer-grid {
  max-width: 1400px;
  margin: 0 auto;

  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    360px;

  gap: 24px;

  align-items: start;
}

.reviewer-grid main,
.reviewer-grid aside {
  min-width: 0;
}

.reviewer-grid main {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.reviewer-grid aside {
  display: flex;
  flex-direction: column;
  gap: 24px;
}


/* =========================================================
   PANELS
   ========================================================= */

.panel {
  border: 1px solid #e2e8f0;
  border-radius: 16px;

  background: #ffffff;

  padding: 24px;

  box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.03);
}

.panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.panel-label {
  margin-bottom: 7px;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;

  color: #94a3b8;
}

.panel h2 {
  margin: 0;

  font-size: 21px;
  font-weight: 750;
  letter-spacing: -0.02em;

  color: #0f172a;
}

.panel h3 {
  margin: 7px 0 0;

  font-size: 17px;
  font-weight: 750;

  color: #0f172a;
}


/* =========================================================
   AI BADGE
   ========================================================= */

.ai-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 34px;
  height: 26px;

  padding: 0 10px;

  border-radius: 7px;

  background: #0f172a;
  color: #ffffff;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
}


/* =========================================================
   AI EMPTY STATE
   ========================================================= */

.ai-empty {
  min-height: 250px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 30px 20px;
}

.ai-icon {
  width: 54px;
  height: 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 15px;

  border-radius: 14px;

  background: #f1f5f9;

  font-size: 25px;
  color: #334155;
}

.ai-empty h3 {
  margin: 0;

  font-size: 17px;
  color: #0f172a;
}

.ai-empty p {
  max-width: 560px;

  margin: 10px auto 20px;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

.primary-button {
  min-height: 42px;

  padding: 0 18px;

  border: none;
  border-radius: 9px;

  background: #0f172a;
  color: #ffffff;

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    opacity 0.15s ease;
}

.primary-button:hover:not(:disabled) {
  transform: translateY(-1px);
  opacity: 0.92;
}

.primary-button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}


/* =========================================================
   VALIDATION RESULT
   ========================================================= */

.analysis-result {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.analysis-summary {
  display: flex;
  align-items: center;
  gap: 14px;

  padding: 17px;

  border-radius: 12px;
}

.analysis-summary.valid {
  border: 1px solid #bbf7d0;
  background: #f0fdf4;
}

.analysis-summary.invalid {
  border: 1px solid #fecaca;
  background: #fef2f2;
}

.analysis-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  font-size: 18px;
  font-weight: 800;
}

.analysis-summary.valid .analysis-icon {
  background: #dcfce7;
  color: #15803d;
}

.analysis-summary.invalid .analysis-icon {
  background: #fee2e2;
  color: #dc2626;
}

.analysis-summary strong {
  display: block;

  font-size: 14px;
  color: #0f172a;
}

.analysis-summary p {
  margin: 5px 0 0;

  font-size: 12px;
  line-height: 1.5;

  color: #64748b;
}


/* =========================================================
   ANALYSIS SECTIONS
   ========================================================= */

.analysis-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.section-title {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #94a3b8;
}


/* =========================================================
   CLEAN RESULT
   ========================================================= */

.clean-result {
  display: flex;
  align-items: center;
  gap: 9px;

  padding: 13px 15px;

  border-radius: 9px;

  background: #f8fafc;

  color: #475569;

  font-size: 13px;
}

.clean-result span {
  color: #16a34a;
  font-weight: 800;
}


/* =========================================================
   ISSUES
   ========================================================= */

.issues-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.issue-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 13px 14px;

  border: 1px solid #fee2e2;
  border-radius: 10px;

  background: #fffafa;
}

.issue-number {
  width: 24px;
  height: 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: #fee2e2;
  color: #dc2626;

  font-size: 11px;
  font-weight: 800;
}

.issue-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.issue-content strong {
  font-size: 13px;
  color: #334155;
}

.issue-content small {
  color: #94a3b8;
  font-size: 11px;
}


/* =========================================================
   AI EXPLANATION
   ========================================================= */

.ai-explanation {
  padding: 16px;

  border-radius: 11px;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.ai-explanation strong {
  display: block;

  font-size: 13px;
  color: #0f172a;
}

.ai-explanation p {
  margin: 8px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}


/* =========================================================
   RISK PANEL
   ========================================================= */

.risk-panel {
  overflow: hidden;
}

.risk-icon {
  font-size: 22px;
}

.risk-result {
  display: flex;
  flex-direction: column;
  gap: 20px;
}


/* =========================================================
   RISK OVERVIEW
   ========================================================= */

.risk-overview {
  display: flex;
  align-items: center;
  gap: 24px;

  padding: 20px;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  background: #fafafa;
}

.risk-score-box {
  width: 118px;
  height: 118px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: #ffffff;

  border: 8px solid #e2e8f0;
}

.risk-score-box.score-low {
  border-color: #bbf7d0;
}

.risk-score-box.score-medium {
  border-color: #fde68a;
}

.risk-score-box.score-high {
  border-color: #fecaca;
}

.risk-score {
  font-size: 35px;
  line-height: 1;

  font-weight: 850;

  letter-spacing: -0.04em;
}

.risk-score-label {
  margin-top: 7px;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.1em;

  color: #94a3b8;
}

.risk-summary {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.risk-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;

  color: #94a3b8;
}

.risk-level {
  font-size: 24px;
  font-weight: 850;
}

.risk-level.low {
  color: #047857;
}

.risk-level.medium {
  color: #b45309;
}

.risk-level.high {
  color: #dc2626;
}

.risk-confidence {
  font-size: 12px;
  color: #64748b;
}


/* =========================================================
   RECOMMENDATION
   ========================================================= */

.risk-recommendation {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 16px 18px;

  border: 1px solid #e2e8f0;
  border-radius: 11px;

  background: #f8fafc;
}

.risk-recommendation > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.risk-recommendation span {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;

  color: #94a3b8;
}

.recommendation-badge {
  font-size: 14px;
  font-weight: 850;
}

.recommendation-badge.approve {
  color: #047857;
}

.recommendation-badge.human-review {
  color: #b45309;
}

.recommendation-badge.reject {
  color: #dc2626;
}

.recommendation-confidence {
  font-size: 12px;
  font-weight: 700;
  color: #64748b;
}


/* =========================================================
   RISK FACTORS
   ========================================================= */

.risk-factors {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.risk-factor {
  padding: 14px 15px;

  border: 1px solid #e2e8f0;
  border-radius: 11px;

  background: #ffffff;
}

.risk-factor-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.risk-factor-top > strong {
  font-size: 13px;
  color: #0f172a;
}

.risk-factor-tags {
  display: flex;
  align-items: center;
  gap: 6px;
}

.risk-severity,
.risk-impact {
  padding: 4px 8px;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.risk-severity.low {
  background: #ecfdf5;
  color: #047857;
}

.risk-severity.medium {
  background: #fffbeb;
  color: #b45309;
}

.risk-severity.high {
  background: #fef2f2;
  color: #dc2626;
}

.risk-impact.positive {
  background: #ecfdf5;
  color: #047857;
}

.risk-impact.negative {
  background: #fef2f2;
  color: #dc2626;
}

.risk-impact.neutral {
  background: #f1f5f9;
  color: #475569;
}

.risk-factor p {
  margin: 8px 0 0;

  font-size: 12px;
  line-height: 1.55;

  color: #64748b;
}


/* =========================================================
   RISK VALIDATION
   ========================================================= */

.risk-validation {
  display: flex;
  align-items: center;
  gap: 11px;

  padding: 13px 15px;

  border-radius: 10px;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.validation-check {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: #ecfdf5;
  color: #047857;

  font-weight: 800;
}

.risk-validation strong {
  display: block;

  font-size: 12px;
  color: #334155;
}

.risk-validation p {
  margin: 3px 0 0;

  font-size: 11px;
  color: #94a3b8;
}


/* =========================================================
   LOAN DATA
   ========================================================= */

.data-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  border-top: 1px solid #e2e8f0;
  border-left: 1px solid #e2e8f0;

  border-radius: 10px;
  overflow: hidden;
}

.data-item {
  min-height: 75px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 13px 15px;

  border-right: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;

  background: #ffffff;
}

.data-item span {
  margin-bottom: 5px;

  font-size: 10px;
  font-weight: 700;

  color: #94a3b8;
}

.data-item strong {
  font-size: 13px;
  color: #334155;

  word-break: break-word;
}


/* =========================================================
   DECISION PANEL
   ========================================================= */

.decision-panel > h2 {
  margin-top: 2px;
}

.decision-panel > p {
  margin: 8px 0 18px;

  font-size: 12px;
  line-height: 1.55;

  color: #64748b;
}

.ai-decision-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 14px;
  padding: 11px 12px;

  border-radius: 9px;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.ai-decision-hint span {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.08em;

  color: #94a3b8;
}

.decision {
  width: 100%;

  min-height: 64px;

  display: flex;
  align-items: center;

  gap: 12px;

  margin-top: 10px;
  padding: 11px 13px;

  border-radius: 10px;

  text-align: left;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    opacity 0.15s ease;
}

.decision:hover:not(:disabled) {
  transform: translateY(-1px);
}

.decision:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.decision > span {
  width: 31px;
  height: 31px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  font-size: 15px;
  font-weight: 850;
}

.decision > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.decision strong {
  font-size: 13px;
}

.decision small {
  font-size: 10px;
}

.decision.approve {
  border: 1px solid #bbf7d0;
  background: #f0fdf4;
  color: #166534;
}

.decision.approve > span {
  background: #dcfce7;
  color: #15803d;
}

.decision.review {
  border: 1px solid #fde68a;
  background: #fffbeb;
  color: #92400e;
}

.decision.review > span {
  background: #fef3c7;
  color: #b45309;
}

.decision.reject {
  border: 1px solid #fecaca;
  background: #fef2f2;
  color: #991b1b;
}

.decision.reject > span {
  background: #fee2e2;
  color: #dc2626;
}


/* =========================================================
   DATA QUALITY
   ========================================================= */

.quality-score {
  display: flex;
  align-items: center;
  gap: 13px;

  margin: 18px 0;
}

.score-circle {
  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  border: 5px solid #dcfce7;

  color: #15803d;

  font-size: 17px;
  font-weight: 850;
}

.quality-score strong {
  display: block;

  font-size: 13px;
  color: #334155;
}

.quality-score p {
  max-width: 170px;

  margin: 4px 0 0;

  font-size: 10px;
  line-height: 1.5;

  color: #94a3b8;
}

.quality-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 0;

  border-top: 1px solid #e2e8f0;
}

.quality-row span {
  font-size: 11px;
  color: #64748b;
}

.quality-row strong {
  font-size: 11px;
  color: #334155;
  text-transform: uppercase;
}


/* =========================================================
   RISK SUMMARY SIDEBAR
   ========================================================= */

.risk-summary-panel {
  min-height: 210px;
}

.mini-risk-score {
  display: flex;
  align-items: baseline;

  margin: 14px 0 17px;
}

.mini-risk-score strong {
  font-size: 38px;
  line-height: 1;

  letter-spacing: -0.04em;
}

.mini-risk-score span {
  margin-left: 5px;

  font-size: 11px;

  color: #94a3b8;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 10px 0;

  border-top: 1px solid #e2e8f0;
}

.summary-row span {
  font-size: 11px;
  color: #64748b;
}

.summary-row strong {
  font-size: 11px;
  text-transform: uppercase;
}

.risk-summary-empty {
  min-height: 130px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.risk-summary-empty > span {
  font-size: 30px;
  color: #cbd5e1;
}

.risk-summary-empty p {
  max-width: 210px;

  margin: 8px 0 0;

  font-size: 11px;
  line-height: 1.5;

  color: #94a3b8;
}


/* =========================================================
   AUDIT
   ========================================================= */

.audit-panel h3 {
  margin-top: 2px;
}

.timeline {
  position: relative;

  display: flex;
  flex-direction: column;

  margin-top: 20px;
}

.timeline-item {
  position: relative;

  display: flex;

  gap: 12px;

  padding-bottom: 20px;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item > span {
  position: relative;

  width: 9px;
  height: 9px;

  margin-top: 4px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #94a3b8;
}

.timeline-item:not(:last-child)::after {
  content: "";

  position: absolute;

  left: 4px;
  top: 13px;

  width: 1px;
  height: calc(100% - 9px);

  background: #e2e8f0;
}

.timeline-item strong {
  display: block;

  font-size: 11px;
  color: #334155;
}

.timeline-item small {
  display: block;

  margin-top: 3px;

  font-size: 10px;
  color: #94a3b8;
}


/* =========================================================
   LOADING
   ========================================================= */

.reviewer-loading {
  min-height: 70vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 15px;
}

.reviewer-loading p {
  margin: 0;

  font-size: 13px;
  color: #64748b;
}

.loading-spinner {
  width: 30px;
  height: 30px;

  border: 3px solid #e2e8f0;
  border-top-color: #0f172a;

  border-radius: 50%;

  animation: reviewer-spin 0.8s linear infinite;
}

@keyframes reviewer-spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   ERROR
   ========================================================= */

.reviewer-error {
  max-width: 500px;

  margin: 100px auto;

  padding: 30px;

  border: 1px solid #e2e8f0;
  border-radius: 16px;

  background: #ffffff;

  text-align: center;
}

.reviewer-error h2 {
  margin: 0;

  font-size: 22px;
  color: #0f172a;
}

.reviewer-error p {
  margin: 10px 0 20px;

  color: #64748b;

  font-size: 13px;
  line-height: 1.5;
}

.back-button {
  min-height: 40px;

  padding: 0 16px;

  border: none;
  border-radius: 8px;

  background: #0f172a;
  color: #ffffff;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {

  .reviewer-page {
    padding: 30px 24px 60px;
  }

  .reviewer-grid {
    grid-template-columns: 1fr;
  }

  .reviewer-grid aside {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .decision-panel {
    grid-column: span 2;
  }

}


@media (max-width: 760px) {

  .reviewer-page {
    padding: 22px 15px 45px;
  }

  .reviewer-header {
    flex-direction: column;
  }

  .reviewer-header h1 {
    font-size: 30px;
  }

  .loan-identity {
    grid-template-columns: 1fr 1fr;
  }

  .loan-identity > div:nth-child(2) {
    border-right: none;
  }

  .loan-identity > div:nth-child(3),
  .loan-identity > div:nth-child(4) {
    border-top: 1px solid #e2e8f0;
  }

  .reviewer-grid aside {
    grid-template-columns: 1fr;
  }

  .decision-panel {
    grid-column: span 1;
  }

  .data-grid {
    grid-template-columns: 1fr;
  }

  .risk-overview {
    align-items: flex-start;
  }

}


@media (max-width: 500px) {

  .loan-identity {
    grid-template-columns: 1fr;
  }

  .loan-identity > div {
    border-right: none;
    border-bottom: 1px solid #e2e8f0;
  }

  .loan-identity > div:last-child {
    border-bottom: none;
  }

  .risk-overview {
    flex-direction: column;
  }

  .risk-recommendation {
    align-items: flex-start;
    flex-direction: column;
  }

  .risk-factor-top {
    align-items: flex-start;
    flex-direction: column;
  }

  .risk-factor-tags {
    flex-wrap: wrap;
  }

  .reviewer-header {
    gap: 15px;
  }

}